---
import BaseLayout from "../layouts/BaseLayout.astro";
import HorizontalCard from "../components/HorizontalCard.astro";
---

<BaseLayout title="Projects" sideBarActiveItemID="projects">
  <div>
    <div class="text-3xl w-full font-bold mb-2">Current Projects</div>
    <p class="text-base-content/70 mb-5">
      Open-source tools for communities. All projects are MIT licensed.
    </p>
  </div>

  <HorizontalCard
    title="local-cleanup"
    img="/local-cleanup.webp"
    desc="Volunteer coordination for neighborhood cleanup. Report spots that need attention, add tasks (litter, weeding, brush clearing), claim work, and mark it done. I built it for Saint Paul, MN but it could be deployed anywhere in the US."
    url="https://cleanup.knrhds.com"
    badge="LIVE"
  />

  <div class="divider my-0"></div>

  <HorizontalCard
    title="docket-checklist"
    img="/docket-checklist.webp"
    desc="Turn a Habeas Dockets assignment PDF into a printable checklist for the trip to the clerk's office: a line for each document's page count, boxes to tick off scanning, uploading, and QA, and running totals. Everything runs in the browser; nothing is uploaded."
    url="https://dockets.knrhds.com"
    badge="LIVE"
  />

  <div class="divider my-0"></div>

  <div class="mt-8">
    <p class="text-base-content/50 italic">More projects coming soon.</p>
  </div>
</BaseLayout>
