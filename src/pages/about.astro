---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" sideBarActiveItemID="about">
  <div class="pb-12 mt-5">
    <div class="text-3xl w-full font-bold mb-5">About</div>
    <div class="prose max-w-none">
      <p>
        I'm Ken Rhodes, a retired software developer and a retired small business owner
        based in Saint Paul, Minnesota.
        I make tools for myself and put them here. Lately I've been focused on civic engagement
        and local coordination.
      </p>
      <p>
        I use Claude Code during development, and I've adopted the guidance provided
        by Linus Torvalds and the Linux kernel maintainers for AI-assisted code
        contributions, adapted for my MIT-licensed and CC0 1.0 projects:
      </p>
      <ul>
        <li>All code must be compatible with the project's license</li>
        <li>
           AI agents can't sign off on code contributions. The human contributor
           is responsible for:
           <ul>
              <li>Reviewing all AI-generated code</li>
              <li>Ensuring compliance with licensing requirements</li>
              <li>Taking full responsibility for the contribution</li>
           </ul>
        </li>
        <li>
           All AI-assisted contributions must contain an Assisted-by tag in
           the following format:<br/>Assisted-by: AGENT_NAME:MODEL_VERSION
        </li>
      </ul>
      <p>
        All of my projects are free to use and share. If you're working
        on something similar or want to deploy one of these tools,
        get in touch.
      </p>

      <h3>Elsewhere</h3>
      <ul>
        <li><a href="https://bsky.app/profile/knrhds.bsky.social" target="_blank">BlueSky (@knrhds.bsky.social)</a></li>
        <li><a href="https://github.com/keenrodent" target="_blank">GitHub (keenrodent)</a></li>
        <li><a href="https://gitlab.com/knrhds" target="_blank">GitLab (knrhds)</a></li>
      </ul>

      <h3>Contact</h3>
      <p>
        <a href="mailto:k@knrhds.com">k@knrhds.com</a>
        <span class="not-prose inline-flex items-center gap-2 align-middle ml-2">
          <button id="copy-email" type="button" class="btn btn-xs btn-soft" data-email="k@knrhds.com">
            Copy
          </button>
          <span id="copy-email-status" class="text-sm text-base-content/60" role="status" aria-live="polite"></span>
        </span>
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  // Delegated so the handler survives ClientRouter page swaps.
  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const button = target.closest("#copy-email");
    if (!button) return;

    const status = document.getElementById("copy-email-status");
    try {
      await navigator.clipboard.writeText(button.dataset.email);
      status.textContent = "Copied";
    } catch {
      status.textContent = "Couldn't copy \u2014 select the address instead";
    }
    setTimeout(() => (status.textContent = ""), 3000);
  });
</script>
